{
  "name": "ghostrender",
  "version": "1.0.0",
  "description": "A dev-only React hook that detects and reports unnecessary component re-renders with zero production overhead.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json",
    "build:watch": "tsc -p tsconfig.esm.json --watch",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "react",
    "hooks",
    "performance",
    "devtools",
    "debug",
    "re-render",
    "unnecessary-renders",
    "optimization",
    "profiling",
    "ghost-render",
    "dev-only"
  ],
  "author": "Anoop Singh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anoopsingh12/ghostrender.git"
  },
  "bugs": {
    "url": "https://github.com/anoopsingh12/ghostrender/issues"
  },
  "homepage": "https://github.com/anoopsingh12/ghostrender#readme",
  "publishConfig": {
    "access": "public"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/anoopsingh12"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "sideEffects": false
}
